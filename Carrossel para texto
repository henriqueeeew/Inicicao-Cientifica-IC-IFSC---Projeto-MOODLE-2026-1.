<div id="carrossel-instalacao"
  style="background-color: #ffffff; border: 4px solid #1b67b0; border-radius: 20px; padding: 20px; box-sizing: border-box; font-family: 'Poppins', sans-serif; margin-inline: auto; margin-bottom: 15px; box-shadow: 4px  4px 10px rgba(0, 0, 0, 0.5); width: 50%;">
  <!-- Conteúdo dos Slides -->
  <div id="slides-container-carrossel"
    style="padding-left: 40px; padding-right: 40px;"><!-- Passo 1 -->
    <div class="item-carrossel text-center" style="display: block;">
      <h3
        style="font-size: 14pt; font-weight: bold; color: #1b67b0; margin-top: 0px; margin-bottom: 12px; text-align: center;">
        1. Acessar o Repositório Oficial</h3>
      <p
        style="font-size: 12pt; color: #000000; text-align: center; line-height: 1.5; margin-bottom: 0px;">
        Abra o navegador de internet e acesse o site oficial do fatiador.
        Localize a área de downloads e selecione a versão compatível com o
        sistema operacional do seu computador.</p>
    </div>
    <!-- Passo 2 -->
    <div class="item-carrossel text-center" style="display: none;">
      <h3
        style="font-size: 14pt; font-weight: bold; color: #1b67b0; margin-top: 0px; margin-bottom: 12px; text-align: center;">
        2. Executar o Instalador</h3>
      <p
        style="font-size: 12pt; color: #000000; text-align: center; line-height: 1.5; margin-bottom: 0px;">
        Após concluir o download, dê um duplo clique sobre o arquivo executável
        para iniciar o assistente. Caso o sistema solicite permissão de
        administrador, confirme selecionando "Sim".</p>
    </div>
    <!-- Passo 3 -->
    <div class="item-carrossel text-center" style="display: none;">
      <h3
        style="font-size: 14pt; font-weight: bold; color: #1b67b0; margin-top: 0px; margin-bottom: 12px; text-align: center;">
        3. Aceitar Termos e Finalizar</h3>
      <p
        style="font-size: 12pt; color: #000000; text-align: center; line-height: 1.5; margin-bottom: 0px;">
        Leia e aceite o Acordo de Licença. Mantenha a pasta de destino padrão
        recomendada pelo instalador, avance as etapas e clique em "Instalar"
        para concluir o processo.</p>
    </div>
  </div>
  <!-- Controles de Navegação e Indicadores Unificados -->
  <div class="d-flex justify-content-between align-items-center mt-4"
    style="gap: 10px;"><!-- Botão Anterior --> <button
      id="btn-carrossel-anterior"
      style="background-color: #1b67b0; color: #ffffff; border: none; padding: 8px 16px; border-radius: 4px; font-weight: bold; font-size: 12pt; cursor: pointer;"
      type="button"> « Anterior </button>
    <!-- Indicadores de Navegação (Bolinhas no meio) -->
    <div class="d-flex justify-content-center align-items-center"
      style="gap: 8px;"><button class="btn-indicador-carrossel"
        style="width: 12px; height: 12px; border-radius: 50%; border: none; background-color: #1b67b0; opacity: 1; cursor: pointer;"
        type="button" aria-label="Ir para Passo 1"></button> <button
        class="btn-indicador-carrossel"
        style="width: 12px; height: 12px; border-radius: 50%; border: none; background-color: #1b67b0; opacity: 0.3; cursor: pointer;"
        type="button" aria-label="Ir para Passo 2"></button> <button
        class="btn-indicador-carrossel"
        style="width: 12px; height: 12px; border-radius: 50%; border: none; background-color: #1b67b0; opacity: 0.3; cursor: pointer;"
        type="button" aria-label="Ir para Passo 3"></button></div>
    <!-- Botão Próximo --> <button id="btn-carrossel-proximo"
      style="background-color: #1b67b0; color: #ffffff; border: none; padding: 8px 16px; border-radius: 4px; font-weight: bold; font-size: 12pt; cursor: pointer;"
      type="button"> Próximo » </button>
  </div>
  <!-- JavaScript Integrado -->
  <script>
    (function() {
      var carrossel = document.getElementById('carrossel-instalacao');
      if (!carrossel) return;

      var slideAtual = 0;
      var slides = carrossel.querySelectorAll('.item-carrossel');
      var indicadores = carrossel.querySelectorAll(
        '.btn-indicador-carrossel');
      var contador = carrossel.querySelector('#contador-carrossel');
      var btnAnterior = carrossel.querySelector('#btn-carrossel-anterior');
      var btnProximo = carrossel.querySelector('#btn-carrossel-proximo');

      function mudarSlide(indice) {
        if (indice < 0) indice = slides.length - 1;
        if (indice >= slides.length) indice = 0;

        slideAtual = indice;

        for (var i = 0; i < slides.length; i++) {
          slides[i].style.display = (i === slideAtual) ? 'block' : 'none';
        }

        for (var k = 0; k < indicadores.length; k++) {
          indicadores[k].style.opacity = (k === slideAtual) ? '1' : '0.3';
        }

        if (contador) {
          contador.textContent = 'Passo ' + (slideAtual + 1) + ' de ' + slides
            .length;
        }
      }

      if (btnAnterior) {
        btnAnterior.addEventListener('click', function() {
          mudarSlide(slideAtual - 1);
        });
      }

      if (btnProximo) {
        btnProximo.addEventListener('click', function() {
          mudarSlide(slideAtual + 1);
        });
      }

      for (var j = 0; j < indicadores.length; j++) {
        (function(index) {
          if (indicadores[index]) {
            indicadores[index].addEventListener('click', function() {
              mudarSlide(index);
            });
          }
        })(j);
      }
    })();
  </script>
</div>
